# Copy to .env and replace the placeholders. Never commit .env.

# Postgres. Read by the application (config.py) AND passed by compose.yaml to the
# postgres container as its initial POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
PG_USER=recsys
PG_PASSWORD=replace_me
PG_DB=recsys
# The API and training scripts run on the host, so they use the published port.
PG_HOST=localhost
PG_PORT=5432

# Qdrant. Read by the application only.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=items
QDRANT_USER_COLLECTION=users

# MLflow tracking server. Read by training only. Published on 5001 because
# macOS AirPlay Receiver occupies 5000.
MLFLOW_TRACKING_URI=http://localhost:5001
